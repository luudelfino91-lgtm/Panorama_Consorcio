				    #"Agrupado" = Table.Group(#"Filtrado Contas", {"CNPJ", "NOME_INSTITUICAO", "NOME_CONTA"}, {{"SALDO", each List.Sum([SALDO]), type nullable number}}),
				    #"Dinamizado" = Table.Pivot(#"Agrupado", List.Distinct(#"Agrupado"[NOME_CONTA]), "NOME_CONTA", "SALDO", List.Sum),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Dinamizado", {{"NOME_INSTITUICAO", "Administradora"}, {"PATRIMÔNIO LÍQUIDO", "Patrimonio_Liquido"}, {"RECEITAS OPERACIONAIS", "Receitas_Operacionais"}, {"(-) DESPESAS OPERACIONAIS", "Despesas_Operacionais"}, {"TOTAL GERAL DO ATIVO", "Total_Ativo"}, {"Ativo Realizável", "Ativo_Realizavel"}, {"TOTAL GERAL DO PASSIVO", "Total_Passivo"}, {"DISPONIBILIDADES", "Disponibilidades"}, {"TÍTULOS E VALORES MOBILIÁRIOS E INSTRUMENTOS FINANCEIROS DERIVATIVOS", "TVM"}, {"RECEITAS DE TAXAS DE ADMINISTRAÇÃO DE CONSÓRCIOS", "Receita_Taxa_Administracao"}}, MissingField.Ignore),
				    #"Ativo Total Calculado" = Table.AddColumn(#"Colunas Renomeadas", "Ativo_Total_Calc", each if [Total_Ativo] <> null then [Total_Ativo] else [Ativo_Realizavel], type nullable number),
