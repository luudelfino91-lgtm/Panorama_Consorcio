				    #"Margem Adicionada" = Table.AddColumn(#"Resultado Adicionado", "Margem_Resultado", each if [Receitas_Operacionais] = null or [Receitas_Operacionais] = 0 then null else [Resultado_Periodo] / [Receitas_Operacionais], type nullable number),
				    #"Liquidez Adicionada" = Table.AddColumn(#"Margem Adicionada", "Liquidez_Disp_TVM", each (if [Disponibilidades] = null then 0 else [Disponibilidades]) + (if [TVM] = null then 0 else [TVM]), type nullable number),
				    #"PL sobre Ativo Adicionado" = Table.AddColumn(#"Liquidez Adicionada", "PL_sobre_Ativo", each if [Ativo_Total_Calc] = null or [Ativo_Total_Calc] = 0 then null else [Patrimonio_Liquido] / [Ativo_Total_Calc], type nullable number),
				    #"Competencia Adicionada" = Table.AddColumn(#"PL sobre Ativo Adicionado", "Competencia", each 202603, Int64.Type),
