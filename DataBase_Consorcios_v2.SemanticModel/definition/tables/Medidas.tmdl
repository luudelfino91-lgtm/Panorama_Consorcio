ize:27px;color:#FFF;line-height:1.05;letter-spacing:.01em}.bk{font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#E3B23C;margin-bottom:8px}.pan .bt{font-family:Georgia,serif;font-style:italic;font-size:13.5px;color:#E3B23C;margin-top:3px}.pan .bs{font-size:10px;color:#A9A7C4;margin-top:7px;letter-spacing:.03em}.pan .bb{border:1px solid #E3B23C;color:#E3B23C;text-decoration:none;font-size:11.5px;font-weight:600;padding:9px 16px;border-radius:99px;white-space:nowrap}.pan .rt{background:#FFFFFF;border-bottom:1px solid #E1DFE8;padding:9px 30px;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#6B6A80;font-weight:700;margin-bottom:16px}</style><div class=""pan""><div class=""bar""><a href=""https://abefin.org.br/comite-dos-profissionais-de-consorcio/"" target=""_blank"" rel=""noopener"" style=""display:block;line-height:0;flex-shrink:0"" aria-label=""Comitê dos Profissionais de Consórcio - ABEFIN""><img src=""data:image/png;base64,"" alt=""Selo do Comitê dos Profissionais de Consórcio (ABEFIN)"" style=""height:76px;width:76px;display:block;filter:drop-shadow(0 1px 4px rgba(0,0,0,.35))""/></a><div style=""flex:1;min-width:0""><div class=""bk"">ABEFIN &middot; Comitê dos Profissionais de Consórcio</div><div class=""bn"" style=""font-size:19px;font-style:italic;line-height:1.4"">&ldquo;Somos a voz que busca representar seus interesses perante as administradoras, órgãos governamentais e a sociedade em geral.&rdquo;</div></div><a class=""bb"" href=""https://abefin.org.br/comite-dos-profissionais-de-consorcio/"" target=""_blank"" rel=""noopener"" style=""flex-shrink:0"">Conheça o Comitê ↗</a></div><div class=""rt"">Panorama do mercado de consórcio · base ABAC/BACEN · jan 2019 a mai 2026</div><div class=""in""><div class=""eb"">Ato 01 · o tamanho do mercado</div><h1 class=""sf"">Sete anos, <em>quase o dobro</em> de cotas. E menos atraso.</h1><p class=""ld"">A carteira ativa saiu de <b>7,55 milhões</b> de cotas em dez/2019 para <b>13,25 milhões</b> em mai/2026: <b>+75,4%</b>. No mesmo intervalo a inadimplência desceu de 11,75% para <b>10,49%</b>, depois de bater <b>14,54% no choque da pandemia</b>. O consórcio não só cresceu: cresceu absorvendo risco melhor.</p><div class=""kp""><div class=""k hi""><span class=""pl"">+75,4%</span><div class=""kl"">Carteira ativa</div><div class=""kv"">13,25 mi</div><div class=""ks"">cotas em mai/2026 · vs. 7,55 mi em dez/2019</div></div><div class=""k""><span class=""pl"">+76,0%</span><div class=""kl"">Cotas vendidas · 2025</div><div class=""kv"">5,26 mi</div><div class=""ks"">último ano fechado · vs. 2,99 mi em 2019</div></div><div class=""k""><span class=""pl"">−1,26 p.p.</span><div class=""kl"">Inadimplência</div><div class=""kv"">10,49%</div><div class=""ks"">vs. 11,75% em dez/2019 · pico 14,54% mai/2020</div></div><div class=""k""><span class=""pl z"">160 registradas</span><div class=""kl"">Administradoras ativas</div><div class=""kv"">124</div><div class=""ks"">com carteira ativa no último mês</div></div></div><div class=""cd"" style=""margin-top:12px""><div class=""tt"">Evolução mensal · jan 2019 a mai 2026</div><h2 class=""sf"">Carteira e inadimplência andaram em direções opostas</h2><svg viewBox=""0 0 1120 300"" xmlns=""http://www.w3.org/2000/svg""><defs><linearGradient id=""ga"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#4B3B9E"" stop-opacity="".9""/><stop offset=""100%"" stop-color=""#4B3B9E"" stop-opacity="".15""/></linearGradient></defs><rect x=""219"" y=""16"" width=""103"" height=""256"" fill=""#E7E5EF"" opacity="".8""/><text x=""270"" y=""29"" text-anchor=""middle"" class=""ax"">choque 2020</text><line x1=""58"" x2=""1068"" y1=""272.0"" y2=""272.0"" class=""gl""/><text x=""49"" y=""275.5"" text-anchor=""end"" class=""ax"">0</text><line x1=""58"" x2=""1068"" y1=""217.1"" y2=""217.1"" class=""gl""/><text x=""49"" y=""220.6"" text-anchor=""end"" class=""ax"">3 mi</text><line x1=