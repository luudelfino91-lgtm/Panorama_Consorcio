rteira</th><th>Variação no ano</th></tr><tr><td class=""ps"">01</td><td class=""nm"">Klubi</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:100%;background:#C0453E""></span></span></td><td class=""vl"" style=""color:#C0453E"">31,56%</td><td class=""dt"" style=""color:#C0453E"">+3,49</td></tr><tr><td class=""ps"">02</td><td class=""nm"">Bamaq</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:67%;background:#C0453E""></span></span></td><td class=""vl"" style=""color:#C0453E"">21,13%</td><td class=""dt"" style=""color:#8A6A16"">-2,31</td></tr><tr><td class=""ps"">03</td><td class=""nm"">Yamaha</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:54%;background:#E3B23C""></span></span></td><td class=""vl"" style=""color:#E3B23C"">16,90%</td><td class=""dt"" style=""color:#8A6A16"">-1,76</td></tr><tr><td class=""ps"">04</td><td class=""nm"">Canopus</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:50%;background:#E3B23C""></span></span></td><td class=""vl"" style=""color:#E3B23C"">15,86%</td><td class=""dt"" style=""color:#C0453E"">+0,53</td></tr><tr><td class=""ps"">05</td><td class=""nm"">Volkswagen</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:48%;background:#E3B23C""></span></span></td><td class=""vl"" style=""color:#E3B23C"">15,25%</td><td class=""dt"" style=""color:#8A6A16"">-0,47</td></tr><tr><td class=""ps"">06</td><td class=""nm"">Ademicon</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:47%;background:#E3B23C""></span></span></td><td class=""vl"" style=""color:#E3B23C"">14,71%</td><td class=""dt"" style=""color:#C0453E"">+1,72</td></tr><tr><td class=""ps"">07</td><td class=""nm"">Gazin</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:46%;background:#E3B23C""></span></span></td><td class=""vl"" style=""color:#E3B23C"">14,42%</td><td class=""dt"" style=""color:#8A6A16"">-1,99</td></tr><tr><td class=""ps"">08</td><td class=""nm"">Disal</td><td class=""bc""><span class=""bo""><span class=""bi"" style=""width:45%;background:#E3B23C""></span></span></td><td class=""vl"" style=""color:#E3B23C"">14,14%</td><td class=""dt"" style=""color:#8A6A16"">-2,00</td></tr></table></div></div><p style=""font-size:11px;color:#6B6A80;margin:10px 0 0"">Apenas administradoras com carteira ≥ 0,5% do mercado (28 elegíveis). Coluna à direita: variação em p.p. contra o mesmo mês do ano anterior.</p><div class=""cd"" style=""margin-top:12px""><div class=""tt"">Contemplados e fila de espera · mai 2026</div><h2 class=""sf"">Quem atrasa mais: quem já recebeu o bem, ou quem ainda espera?</h2><p style=""font-size:12px;color:#4A5852;margin:8px 0 0"">A intuição do mercado diz que o contemplado, com o bem na mão, teria menos incentivo a pagar. Os dados dizem o contrário: <b>contemplados atrasam 9,22%</b> contra <b>11,65% de quem ainda não foi contemplado</b>. A exceção é gritante em Serviços, onde a fila atrasa 37,9%.</p><svg viewBox=""0 0 1120 270"" xmlns=""http://www.w3.org/2000/svg""><line x1=""52"" x2=""1100"" y1=""226.0"" y2=""226.0"" class=""gl""/><text x=""43"" y=""229.5"" text-anchor=""end"" class=""ax"">0%</text><line x1=""52"" x2=""1100"" y1=""174.0"" y2=""174.0"" class=""gl""/><text x=""43"" y=""177.5"" text-anchor=""end"" class=""ax"">10%</text><line x1=""52"" x2=""1100"" y1=""122.0"" y2=""122.0"" class=""gl""/><text x=""43"" y=""125.5"" text-anchor=""end"" class=""ax"">20%</text><line x1=""52"" x2=""1100"" y1=""70.0"" y2=""70.0"" class=""gl""/><text x=""43"" y=""73.5"" text-anchor=""end"" class=""ax"">30%</text><line x1=""52"" x2=""1100"" y1=""18.0"" y2=""18.0"" class=""gl""/><text x=""43"" y=""21.5"" text-anchor=""end"" class=""ax"">40%</text><rect x=""97.9"" y=""178.1"" width=""26"" height=""47.9"" rx=""3"" fill=""#4B3B9E""/><text x=""110.9"" y=""170.1"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">9,2%</text><rect x=""129.9"" y=""165.4"" width=""26"" height=""60.6"" rx=""3"" fill=""#C99A2E""/><text x=""142.9"" y=""157.4"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">11,7%</text><text x=""126.9"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""700"" fill=""#1C1B2E"">MERCADO</text><line x1=""201.7"" x2=""201.7"" y1=""18"" y2=""234"" stroke=""#E1DFE8""/><rect x=""247.6"" y=""182.3"" width=""26"" height=""43.7"" rx=""3"" fill=""#4B3B9E""/><text x=""260.6"" y=""174.3"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">8,4%</text><rect x=""279.6"" y=""172.1"" width=""26"" height=""53.9"" rx=""3"" fill=""#C99A2E""/><text x=""292.6"" y=""164.1"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">10,4%</text><text x=""276.6"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""500"" fill=""#6B6A80"">MOTOCICLETAS</text><rect x=""397.3"" y=""168.7"" width=""26"" height=""57.3"" rx=""3"" fill=""#4B3B9E""/><text x=""410.3"" y=""160.7"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">11,0%</text><rect x=""429.3"" y=""162.7"" width=""26"" height=""63.3"" rx=""3"" fill=""#C99A2E""/><text x=""442.3"" y=""154.7"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">12,2%</text><text x=""426.3"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""500"" fill=""#6B6A80"">AUTOMÓVEIS</text><rect x=""547.0"" y=""195.7"" width=""26"" height=""30.3"" rx=""3"" fill=""#4B3B9E""/><text x=""560.0"" y=""187.7"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">5,8%</text><rect x=""579.0"" y=""166.8"" width=""26"" height=""59.2"" rx=""3"" fill=""#C99A2E""/><text x=""592.0"" y=""158.8"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">11,4%</text><text x=""576.0"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""500"" fill=""#6B6A80"">IMÓVEIS</text><rect x=""696.7"" y=""175.0"" width=""26"" height=""51.0"" rx=""3"" fill=""#4B3B9E""/><text x=""709.7"" y=""167.0"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">9,8%</text><rect x=""728.7"" y=""159.3"" width=""26"" height=""66.7"" rx=""3"" fill=""#C99A2E""/><text x=""741.7"" y=""151.3"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">12,8%</text><text x=""725.7"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""500"" fill=""#6B6A80"">PESADOS</text><rect x=""846.4"" y=""139.9"" width=""26"" height=""86.1"" rx=""3"" fill=""#4B3B9E""/><text x=""859.4"" y=""131.9"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">16,6%</text><rect x=""878.4"" y=""29.0"" width=""26"" height=""197.0"" rx=""3"" fill=""#C99A2E""/><text x=""891.4"" y=""21.0"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">37,9%</text><text x=""875.4"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""500"" fill=""#6B6A80"">SERVIÇOS</text><rect x=""996.1"" y=""162.8"" width=""26"" height=""63.2"" rx=""3"" fill=""#4B3B9E""/><text x=""1009.1"" y=""154.8"" text-anchor=""middle"" class=""axb"" fill=""#4B3B9E"">12,2%</text><rect x=""1028.1"" y=""167.6"" width=""26"" height=""58.4"" rx=""3"" fill=""#C99A2E""/><text x=""1041.1"" y=""159.6"" text-anchor=""middle"" class=""axb"" fill=""#4F6B22"">11,2%</text><text x=""1025.1"" y=""246"" text-anchor=""middle"" class=""ax"" font-weight=""500"" fill=""#6B6A80"">ELETROELETRÔNICOS</text></svg><div class=""lg""><span><i class=""sw"" style=""background:#4B3B9E""></i>Já contemplados</span><span><i class=""sw"" style=""background:#C99A2E""></i>Não contemplado</span></div></div><div class=""sp""></div><div class=""row"" style=""margin-top:22px""><div class=""nt""><b>Olhe a taxa, não o tamanho.</b><br>As três maiores concentram 42,7% da inadimplência porque concentram 45,1% da carteira. Volume não é sinal de má gestão. A taxa é.</div><div class=""nt""><b>Cheque a tendência, não só o nível.</b><br>Uma administradora em 14% piorando 1,7 p.p. é um caso diferente de uma em 14% melhorando 2,0 p.p.</div><div class=""nt""><b>Segmento carrega risco próprio.</b><br>Imóveis roda a 9,96% e Serviços a 25,2%. Comparar sem controlar por mix produz ranking enviesado.</div></div><div class=""sp"" style=""margin:16px 0 10px""></div><div class=""ft""><b>Fonte:</b> dados públicos de consórcio (ABAC/BACEN), jan/2019 a mai/2026, 89 meses, 160 administradoras, 124 com carteira ativa no último mês. &nbsp;<b>Método:</b> carteira ativa = cotas ativas contempladas + não contempladas; inadimplência = cotas ativas inadimplentes ÷ carteira ativa; CAGR sobre anos completos. &nbsp;<b>Limitações:</b> a base operacional traz apenas quantidades de cotas: não há valor em R$ nem ticket médio por cota. 2026 é parcial (até maio). Indicadores financeiros agregados (Patrimônio Líquido, Receita e Resultado por administradora) constam apenas na proposta de página com dados do Banco Central (BCB), sujeita à aprovação da presidência.</div><div class=""sp"" style=""margin:16px 0 12px""></div><div style=""display:flex;align-items:center;justify-content:space-between;gap:20px""><div style=""font-size:11.5px;color:#6B6A80"">Análise e visualização por <b style=""color:#1C1B2E"">Lucas Delfino</b><br>Analista de BI · Dados de Crédito e Cobrança</div><a href=""https://www.linkedin.com/in/lucasdelfino-/"" target=""_blank"" rel=""noopener"" style=""border:1px solid #4B3B9E;color:#4B3B9E;text-decoration:none;font-size:11.5px;font-weight:600;padding:9px 16px;border-radius:99px"">linkedin.com/in/lucasdelfino-</a></div></div></div>"
		displayFolder: 30 HTML
		lineageTag: 0ac2778a-6699-426e-a34b-ae4a739300f5

	/// HTML da pagina de Documentacao, gerado a partir do proprio modelo.
	measure 'HTML Documentacao' =
			
			"<style>.doc{background:#EEF2F8;color:#1C1B2E;font-family:'Segoe UI',system-ui,sans-serif;line-height:1.5;padding:0 0 20px}.doc *{box-sizing:border-box}.doc .in{padding:0 30px}.doc .bar{background:linear-gradient(105deg,#15151F 0%,#2B2B3A 40%,#4B3B9E 78%,#6E63D6 100%);padding:22px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px}.doc .bn{font-family:Georgia,serif;font-size:27px;color:#FFF;line-height:1.05}.bk{font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#E3B23C;margin-bottom:8px}.doc .bt{font-family:Georgia,serif;font-style:italic;font-size:13.5px;color:#E3B23C;margin-top:3px}.doc .bb{border:1px solid #E3B23C;color:#E3B23C;text-decoration:none;font-size:11.5px;font-weight:600;padding:9px 16px;border-radius:99px;white-space:nowrap}.doc .rt{background:#FFFFFF;border-bottom:1px solid #E1DFE8;padding:9px 30px;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#6B6A80;font-weight:700;margin-bottom:14px}.doc h1{font-family:Georgia,serif;font-weight:400;font-size:26px;margin:0;letter-spacing:-.012em}.doc .ld{font-size:12.5px;color:#4C4A60;max-width:80ch;margin:10px 0 0}.doc h2{font-family:Georgia,serif;font-weight:400;font-size:16px;margin:0}.doc .eb{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#6B6A80;font-weight:700;margin:0 0 12px;display:flex;align-items:center;gap:10px}.doc .eb:before{content:"""";width:24px;height:2px;background:#E3B23C}.doc .fh{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(90deg,#0B2A4A 0%,#1F6FB2 100%);color:#FFF;padding:7px 14px;border-radius:8px 8px 0 0;margin:-13px -16px 10px -16px}.doc .fhn{font-family:Georgia,serif;font-size:13px;font-weight:600;letter-spacing:.01em}.doc .fhc{font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#DCEAF7;background:rgba(255,255,255,.16);padding:3px 9px;border-radius:99px;white-space:nowrap}.doc .cd{background:#FFFFFF;border:1px solid #E1DFE8;border-radius:14px;padding:13px 16px;margin-top:8px}.doc .gl{font-size:12px;color:#4C4A60;margin:6px 0 0}.doc table{width:100%;border-collapse:collapse;margin-top:8px;font-size:10.5px}.doc th{font-size:8.5px;letter-spacing:.09em;text-transform:uppercase;color:#6B6A80;font-weight:700;text-align:left;padding:0 8px 4px 0;border-bottom:1px solid #E1DFE8;vertical-align:bottom}.doc td{padding:5px 8px 5px 0;border-bottom:1px solid #EAE8F0;vertical-align:top}.doc tr:last-child td{border-bottom:0}.doc .nm{font-weight:600;width:26%;color:#1C1B2E}.doc .ds{color:#4C4A60}.doc .fx{font-family:Consolas,'Courier New',monospace;font-size:10px;color:#4B3B9E;background:#F6F5FB;border:1px solid #E7E5F2;border-radius:6px;padding:6px 8px;white-space:pre-wrap;word-break:break-word;display:block}.doc .fmt{width:9%;font-family:Consolas,monospace;font-size:9px;color:#9C9AB6;white-space:nowrap}.doc .row{display:flex;gap:12px;margin-top:8px}.doc .row>*{flex:1;min-width:0}.doc .kk{font-size:11.5px;color:#4C4A60}.doc .kk b{color:#1C1B2E}.doc .tag{display:inline-block;font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;border-radius:99px;background:#EDEBF6;color:#4B3B9E;margin-left:6px}.doc .tag.imp{background:#FBF0DA;color:#8A6A16}.doc .nt{background:#FFFFFF;border:1px solid #E1DFE8;border-left:3px solid #E3B23C;border-radius:10px;padding:9px 14px;font-size:11.5px;color:#4C4A60;margin-top:8px}.doc .sp{height:1px;background:#E1DFE8;margin:16px 0}.doc .ft{font-size:10px;color:#6B6A80;line-height:1.7;margin-top:8px}</style><div class=""doc""><div class=""bar""><a href=""https://abefin.org.br/comite-dos-profissionais-de-consorcio/"" target=""_blank"" rel=""noopener"" style=""display:block;line-height:0;flex-shrink:0"" aria-label=""Comitê dos Profissionais de Consórcio - ABEFIN""><img src=""data:image/png;base64,"" alt=""Selo do Comitê dos Profissionais de Consórcio (ABEFIN)"" style=""height:76px;width:76px;display:block;filter:drop-shadow(0 1px 4px rgba(0,0,0,.35))""/></a><div style=""flex:1;min-width:0""><div class=""bk"">ABEFIN &middot; Comitê dos Profissionais de Consórcio</div><div class=""bn"" style=""font-size:19px;font-style:italic;line-height:1.4"">&ldquo;Somos a voz que busca representar seus interesses perante as administradoras, órgãos governamentais e a sociedade em geral.&rdquo;</div></div><a class=""bb"" href=""https://abefin.org.br/comite-dos-profissionais-de-consorcio/"" target=""_blank"" rel=""noopener"" style=""flex-shrink:0"">Conheça o Comitê ↗</a></div><div class=""rt"">Documentação técnica do modelo · dicionário de medidas e regras de cálculo</div><div class=""in""><div class=""eb"">Como este relatório calcula</div><h1>Documentação do modelo</h1><p class=""ld"">Este relatório tem <b>78</b> medidas em <b>12</b> tabelas. Toda medida listada aqui é usada por algum visual, direta ou indiretamente: o modelo foi limpo de tudo que não sustenta a análise. As fórmulas abaixo saíram do próprio arquivo, não foram transcritas à mão.</p><div class=""sp""></div><div class=""eb"">Definições que valem para tudo</div><h2>Os quatro conceitos que sustentam o resto</h2><div class=""row""><div class=""cd""><div class=""kk""><b>Carteira ativa</b><br>Cotas ativas contempladas mais cotas ativas não contempladas. É um estoque, não um fluxo: cada mês traz a foto de quantas cotas existem, então somar meses não faz sentido.</div></div><div class=""cd""><div class=""kk""><b>Inadimplência</b><br>Cotas ativas em atraso divididas pela carteira ativa, somando contemplados e quem ainda não foi contemplado. É taxa da carteira, não do fluxo de vendas.</div></div></div><div class=""row""><div class=""cd""><div class=""kk""><b>Fim de período</b><br>Medidas com o sufixo <i>(Fim)</i> usam LASTNONBLANKVALUE sobre a data. No recorte de um ano inteiro, entregam dezembro, e não a soma dos doze meses.</div></div><div class=""cd""><div class=""kk""><b>Atual</b><br>Medidas com o sufixo <i>(Atual)</i> ignoram o filtro de calendário e travam no último mês disponível na base. Sustentam a narrativa do Panorama, que precisa ser estável.</div></div></div><div class=""sp""></div><div class=""eb"">Dicionário de medidas</div><h2>Agrupadas pela pasta em que aparecem no painel de campos</h2><div class=""row"" style=""align-items:flex-start""><div class=""cd""><div class=""fh""><span class=""fhn"">01 Base</span><span class=""fhc"">8 medidas</span></div><p class=""gl"">Blocos elementares. Tudo mais é construído a partir daqui.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Carteira Ativa</td><td class=""ds"">Total de cotas ativas na carteira (em dia + inadimplentes), somado ao longo do recorte selecionado. Para o saldo em um ponto no tempo, use Carteira Ativa (Fim).</td></tr><tr><td class=""nm"">Cotas Comercializadas</td><td class=""ds"">Quantidade de cotas comercializadas (vendidas) no mês, dentro do recorte selecionado.</td></tr><tr><td class=""nm"">Cotas Contempladas Mês</td><td class=""ds"">Quantidade de cotas contempladas no mês, dentro do recorte selecionado.</td></tr><tr><td class=""nm"">Cotas Em Dia</td><td class=""ds"">Quantidade de cotas ativas adimplentes (em dia com os pagamentos), no recorte selecionado.</td></tr><tr><td class=""nm"">Cotas Inadimplentes</td><td class=""ds"">Quantidade de cotas ativas inadimplentes, somando contempladas e não contempladas em atraso, no recorte selecionado.</td></tr><tr><td class=""nm"">Grupos Ativos</td><td class=""ds"">Quantidade de grupos de consórcio em atividade no recorte selecionado.</td></tr><tr><td class=""nm"">Porte (Carteira Ativa)</td><td class=""ds"">Classifica a administradora em Pequena (menos de 10 mil cotas), Média (10 mil a 100 mil) ou Grande (mais de 100 mil) pela carteira ativa atual. Dá contexto de tamanho na comparação entre administradoras.</td></tr><tr><td class=""nm"">Cotas Não Contempladas</td><td class=""ds"">Cotas ativas que ainda não foram contempladas, no recorte selecionado.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">01 Base &middot; Fim de Período</span><span class=""fhc"">2 medidas</span></div><p class=""gl"">Fotografia do último mês dentro do recorte, em vez de soma do período. Carteira é estoque: somar 89 meses daria um número sem significado.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Carteira Ativa (Fim)</td><td class=""ds"">Saldo de fechamento da carteira ativa: pega o valor do último mês do contexto. Use para mostrar o estoque em cartões ou visuais por ano/período, sem dupla contagem.</td></tr><tr><td class=""nm"">Cotas Inadimplentes (Fim)</td><td class=""ds"">Cotas inadimplentes no último mês do contexto (saldo de fechamento).</td></tr></table></div></div><div class=""row"" style=""align-items:flex-start""><div class=""cd""><div class=""fh""><span class=""fhn"">03 Risco</span><span class=""fhc"">1 medida</span></div><p class=""gl"">Inadimplência como razão entre cotas em atraso e carteira ativa.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">% Inadimplência</td><td class=""ds"">Percentual de cotas inadimplentes sobre a carteira ativa, somado ao longo do recorte (média do período). Para a foto no último mês, use % Inadimplência (Fim).</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">03 Risco &middot; Fim de Período</span><span class=""fhc"">1 medida</span></div><p class=""gl"">Mesma lógica de estoque aplicada ao risco.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">% Inadimplência (Fim)</td><td class=""ds"">Inadimplência no último mês do contexto (foto de fechamento), em vez da média do período.</td></tr></table></div></div><div class=""row"" style=""align-items:flex-start""><div class=""cd""><div class=""fh""><span class=""fhn"">04 Taxa</span><span class=""fhc"">1 medida</span></div><p class=""gl"">Taxa de administração, o preço do produto.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Taxa Adm Carteira %</td><td class=""ds"">Taxa de administração média da carteira, ponderada pela quantidade de grupos ativos, no recorte selecionado.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">08 Atual (sem filtro)</span><span class=""fhc"">7 medidas</span></div><p class=""gl"">Ignoram o filtro de calendário e travam no último mês da base. São o que sustenta a narrativa do Panorama, que precisa ser estável.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">% Inadimplência (Atual)</td><td class=""ds"">Inadimplência no último mês disponível na base (foto atual), sem filtro de ano.</td></tr><tr><td class=""nm"">Carteira Ativa (Atual)</td><td class=""ds"">Carteira ativa no último mês disponível na base (foto atual do estoque), ignorando o filtro de ano.</td></tr><tr><td class=""nm"">Última Data Base</td><td class=""ds"">Referência técnica: última data presente na base, ignorando filtros de calendário. Sustenta as medidas (Atual).</td></tr><tr><td class=""nm"">Taxa Adm (Atual) %</td><td class=""ds"">Taxa de administração média no último mês da base, ignorando o filtro de ano.</td></tr><tr><td class=""nm"">Taxa Contemplação (Atual) %</td><td class=""ds"">Contempladas nos últimos 12 meses sobre a média de cotas não contempladas, na foto atual.</td></tr><tr><td class=""nm"">Carteira Ativa Segmento (Atual)</td><td class=""ds"">Carteira ativa do segmento inteiro no último mês, ignorando o filtro de administradora. Serve de denominador para participação.</td></tr><tr><td class=""nm"">Share Carteira no Segmento %</td><td class=""ds"">Participação da administradora na carteira do próprio segmento, na foto atual.</td></tr></table></div></div><div class=""row"" style=""align-items:flex-start""><div class=""cd""><div class=""fh""><span class=""fhn"">12 Inadimplência · Administradora</span><span class=""fhc"">5 medidas</span></div><p class=""gl"">Corte de porte e ranking de risco entre administradoras.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Elegível Ranking Inadimplência</td><td class=""ds"">Indica se a administradora tem pelo menos 0,5% da carteira ativa do mercado, o que evita que administradoras muito pequenas distorçam o ranking de inadimplência.</td></tr><tr><td class=""nm"">Share Carteira Mercado (Atual) %</td><td class=""ds"">Participação da administradora na carteira ativa total do mercado (todos os segmentos), usada como critério de porte no ranking de inadimplência.</td></tr><tr><td class=""nm"">% Inadimplência (Fim) [Gráfico]</td><td class=""ds"">Versão da % Inadimplência (Fim) usada no eixo desacoplado do gráfico por administradora, para que o slicer de seleção não filtre as demais barras.</td></tr><tr><td class=""nm"">Mostrar no Gráfico (Admin)</td><td class=""ds"">1 quando a administradora passa o corte de 0,5% da carteira do mercado ou quando é a selecionada no slicer. Controla quais barras aparecem no gráfico.</td></tr><tr><td class=""nm"">Cor Barra Inadimplência</td><td class=""ds"">Farol de cores fixo do gráfico por administradora: azul abaixo de 10%, amarelo entre 10% e 20%, vermelho acima de 20%. Faixas fixas, não relativas à média, para a leitura não mudar conforme o filtro.</td></tr></table></div></div><div class=""row"" style=""align-items:flex-start""><div class=""cd""><div class=""fh""><span class=""fhn"">12 Inadimplência &middot; Composição</span><span class=""fhc"">2 medidas</span></div><p class=""gl"">Separa a inadimplência entre quem já foi contemplado e quem ainda não foi. As duas pontas se comportam de forma diferente e a distância entre elas é termômetro de estresse.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Peso Contemplados na Inadimplência %</td><td class=""ds"">Fração da inadimplência total que vem de cotas já contempladas.</td></tr><tr><td class=""nm"">Peso Não Contemplados na Inadimplência %</td><td class=""ds"">Fração da inadimplência total que vem de cotas ainda não contempladas.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">13 Grupos</span><span class=""fhc"">5 medidas</span></div><p class=""gl"">O parque de grupos: quantos são criados, quantos se encerram e qual o tamanho médio. Mostra se o sistema está se expandindo em estrutura, não só em cotas vendidas.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Grupos Constituídos</td><td class=""ds"">Grupos criados dentro do período selecionado.</td></tr><tr><td class=""nm"">Grupos Encerrados</td><td class=""ds"">Grupos encerrados dentro do período selecionado.</td></tr><tr><td class=""nm"">Saldo de Grupos</td><td class=""ds"">Constituídos menos encerrados. Negativo indica que o parque de grupos encolheu no período.</td></tr><tr><td class=""nm"">Grupos Ativos (Fim)</td><td class=""ds"">Grupos em atividade no último mês do período. É estoque: não deve ser somado entre meses.</td></tr><tr><td class=""nm"">Cotas por Grupo (Fim)</td><td class=""ds"">Tamanho médio do grupo em cotas ativas, no fim do período.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">14 Contemplação</span><span class=""fhc"">3 medidas</span></div><p class=""gl"">Com que velocidade a fila anda. O índice ajustado compara a administradora com a média do mercado nos segmentos em que ela própria atua, evitando comparar quem vende imóvel com quem vende moto.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Taxa Contemplação Mensal %</td><td class=""ds"">Fração da fila contemplada a cada mês, em média no período.</td></tr><tr><td class=""nm"">Taxa Contemplação Esperada %</td><td class=""ds"">Taxa que a administradora teria se cada segmento dela rodasse na média do mercado. Referência para separar desempenho de mix de produto.</td></tr><tr><td class=""nm"">Índice de Contemplação (vs mix)</td><td class=""ds"">Contemplação observada dividida pela esperada para o mix da própria administradora. Acima de 1 contempla mais rápido que o mercado no mesmo tipo de bem; abaixo de 1, mais devagar.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">15 Cancelamento</span><span class=""fhc"">4 medidas</span></div><p class=""gl"">Cotas excluídas por desistência ou exclusão. Importante: cotas canceladas NÃO entram no cálculo de inadimplência, que usa apenas cotas ativas. O acumulado sofre retificações na fonte, então estas medidas servem para leitura de mercado e de segmento, não para ranquear administradoras.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Cotas Canceladas (Acum)</td><td class=""ds"">Estoque acumulado de cotas excluídas no fim do período. É acumulado histórico: não deve ser somado entre meses.</td></tr><tr><td class=""nm"">Cotas Canceladas no Período</td><td class=""ds"">Cancelamentos ocorridos dentro do recorte, pela variação do estoque acumulado. Fica em branco quando não há mês anterior na base.</td></tr><tr><td class=""nm"">Canceladas por 100 Ativas</td><td class=""ds"">Cotas já canceladas para cada 100 cotas ativas hoje. Indicador de estoque: não depende de diferença entre períodos, então é estável em qualquer recorte.</td></tr><tr><td class=""nm"">Canceladas por 100 Vendidas</td><td class=""ds"">Cancelamentos por 100 cotas vendidas no mesmo período. Lê a qualidade da venda: quanto do que entra não se sustenta.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">16 Ciclo da Cota</span><span class=""fhc"">4 medidas</span></div><p class=""gl"">O que acontece com a cota depois de contemplada: se foi quitada e se o crédito chegou a ser usado. Crédito parado em volume alto pode indicar tempo estrutural de uso, fricção na liberação ou mudança de comportamento — a base não distingue.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Cotas Quitadas (Fim)</td><td class=""ds"">Cotas ativas já quitadas no fim do período.</td></tr><tr><td class=""nm"">Contempladas Acum (Fim)</td><td class=""ds"">Estoque de cotas ativas já contempladas no fim do período.</td></tr><tr><td class=""nm"">Crédito Pendente (Fim)</td><td class=""ds"">Cotas já contempladas cujo crédito ainda não foi utilizado.</td></tr><tr><td class=""nm"">% Crédito Pendente</td><td class=""ds"">Fração dos contemplados que ainda não usou o crédito.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">21 Dinâmico</span><span class=""fhc"">9 medidas</span></div><p class=""gl"">Respondem aos filtros da página Análise. Comparam a seleção contra o mercado. A tabela de abertura por segmento usa um parâmetro de campo: o próprio usuário escolhe, na segmentação ao lado, quais indicadores quer comparar. A página traz ainda uma seção de ciclo da cota, com cancelamento, contemplação e crédito ainda não utilizado.</p><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">% Inadimplência Contemplados</td><td class=""ds"">Inadimplência entre quem já foi contemplado, no recorte selecionado.</td></tr><tr><td class=""nm"">% Inadimplência Não Contemplados</td><td class=""ds"">Inadimplência entre quem ainda não foi contemplado, no recorte selecionado.</td></tr><tr><td class=""nm"">% Inadimplência Mercado</td><td class=""ds"">Inadimplência de todo o mercado no recorte selecionado, ignorando o filtro de administradora.</td></tr><tr><td class=""nm"">Administradora Selecionada</td><td class=""ds"">Nome da administradora filtrada no momento, ou texto padrão quando nenhuma está selecionada.</td></tr><tr><td class=""nm"">Carteira Ativa Mercado (Fim)</td><td class=""ds"">Carteira ativa de todo o mercado no recorte, ignorando o filtro de administradora.</td></tr><tr><td class=""nm"">Período Selecionado</td><td class=""ds"">Texto que descreve o recorte de período em uso no relatório.</td></tr><tr><td class=""nm"">Share Carteira (Fim) %</td><td class=""ds"">Participação da administradora na carteira do mercado, no recorte selecionado.</td></tr><tr><td class=""nm"">Δ Contemplados vs Não Contemplados (p.p.)</td><td class=""ds"">Diferença em pontos percentuais entre a inadimplência de contemplados e a de quem ainda não foi contemplado.</td></tr><tr><td class=""nm"">Δ vs Mercado (p.p.)</td><td class=""ds"">Quanto a inadimplência da administradora está acima (+) ou abaixo (-) da média do mercado, em pontos percentuais.</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">23 Financeiro (BCB)</span><span class=""fhc"">20 medidas</span></div><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">PL (BCB)</td><td class=""ds"">Patrimônio Líquido somado das administradoras, conforme Balancete do Banco Central (documento 4010, competência mais recente disponível).</td></tr><tr><td class=""nm"">Receita Operacional (BCB)</td><td class=""ds"">Receitas operacionais somadas das administradoras, conforme Balancete do Banco Central.</td></tr><tr><td class=""nm"">Despesa Operacional (BCB)</td><td class=""ds"">Despesas operacionais somadas das administradoras (valor já negativo na fonte), conforme Balancete do Banco Central.</td></tr><tr><td class=""nm"">Resultado do Período (BCB)</td><td class=""ds"">Resultado aproximado do período (Receita Operacional + Despesa Operacional) no recorte selecionado. Positivo indica superávit, negativo indica prejuízo no período.</td></tr><tr><td class=""nm"">Margem do Resultado (BCB)</td><td class=""ds"">Resultado do período dividido pela Receita Operacional: a margem financeira agregada do recorte selecionado.</td></tr><tr><td class=""nm"">Receita Taxa Administração (BCB)</td><td class=""ds"">Receita de taxas de administração de consórcios somada das administradoras, conforme Balancete do Banco Central.</td></tr><tr><td class=""nm"">Ativo Total (BCB)</td><td class=""ds"">Ativo total somado das administradoras (Total Geral do Ativo; usa Ativo Realizável como alternativa quando o total não é reportado), conforme Balancete do Banco Central. ATENÇÃO: para administradoras ligadas a conglomerados financeiros maiores, 'Total Geral do Ativo' pode refletir o balanço completo da instituição, não apenas a operação de consórcio (diferença observada de até ~95% frente à soma de Ativo Realizável + Ativo Permanente), portanto não é comparável entre administradoras de perfis distintos.</td></tr><tr><td class=""nm"">PL sobre Ativo (BCB)</td><td class=""ds"">Patrimônio Líquido dividido pelo Ativo Total: indica a capitalização (quanto do ativo é financiado com capital próprio) do recorte selecionado. ATENÇÃO: sujeito à mesma ressalva de 'Ativo Total (BCB)': não é comparável entre administradoras ligadas a conglomerados financeiros maiores e administradoras independentes.</td></tr><tr><td class=""nm"">Liquidez Disponível (BCB)</td><td class=""ds"">Disponibilidades somadas a Títulos e Valores Mobiliários, usada como proxy de liquidez imediata das administradoras, conforme Balancete do Banco Central.</td></tr><tr><td class=""nm"">Qtd Administradoras (BCB)</td><td class=""ds"">Quantidade de administradoras com dado financeiro reportado ao Banco Central no recorte selecionado.</td></tr><tr><td class=""nm"">Qtd Administradoras com Prejuízo (BCB)</td><td class=""ds"">Quantidade de administradoras que fecharam o período com resultado negativo (prejuízo), conforme Balancete do Banco Central.</td></tr><tr><td class=""nm"">% Administradoras com Prejuízo (BCB)</td><td class=""ds"">Percentual de administradoras com resultado negativo (prejuízo) no período, sobre o total de administradoras com dado financeiro disponível.</td></tr><tr><td class=""nm"">Receita por Cota (BCB)</td><td class=""ds"">Receita de taxa de administração dividida pela Carteira Ativa (cotas em dia + inadimplentes), usada como proxy de receita média por cota sob gestão, cruzando dado financeiro (BCB) com dado operacional (base do Comitê).</td></tr><tr><td class=""nm"">PL Top 5 % (BCB)</td><td class=""ds"">Participação das N administradoras com maior Patrimônio Líquido sobre o total do Patrimônio Líquido do sistema (N definido pelo parâmetro 'TopNFinanceiro Value'). ATENÇÃO: para administradoras ligadas a conglomerados financeiros maiores, o Patrimônio Líquido reportado ao BCB pode refletir capital da instituição inteira, não apenas da operação de consórcio, por isso este indicador deve ser lido com essa ressalva. Prefira 'Receita Top N % (BCB)' para leitura de concentração de mercado.</td></tr><tr><td class=""nm"">Receita Top N % (BCB)</td><td class=""ds"">Participação das N administradoras com maior Receita de Taxa de Administração sobre o total do sistema (N definido pelo parâmetro 'TopNFinanceiro Value'). Indicador de concentração de mercado recomendado, por ser calculado sobre uma métrica de receita operacional segmentada, o que a torna mais comparável entre administradoras do que indicadores de Patrimônio Líquido ou Ativo Total.</td></tr><tr><td class=""nm"">Qtd Administradoras no Limiar (BCB)</td><td class=""ds"">Quantidade mínima de administradoras (ordenadas da maior para a menor Receita de Taxa de Administração) necessária para atingir o limiar percentual definido pelo parâmetro 'LimiarConcentracao Value' (análise de concentração dinâmica, tipo 80/20).</td></tr><tr><td class=""nm"">% Administradoras no Limiar (BCB)</td><td class=""ds"">Percentual que a quantidade de administradoras no limiar de concentração representa sobre o total de administradoras com dado financeiro disponível.</td></tr><tr><td class=""nm"">Resumo Concentração (BCB)</td><td class=""ds"">Frase-resumo da análise de concentração dinâmica (tipo 80/20): quantas administradoras, e que fração do total, concentram o limiar percentual de receita definido pelo usuário.</td></tr><tr><td class=""nm"">Saldo do Item (BCB)</td><td class=""ds"">Soma dos saldos da tabela detalhada de contas do balancete (ft_BCB_ContaDetalhe), usada na matriz de balanço padrão por administradora selecionada.</td></tr><tr><td class=""nm"">Receita por Faixa (BCB)</td><td class=""ds"">Receita de Taxa de Administração somada, dividida entre ""Top N"" (as N administradoras com maior receita, N definido pelo parâmetro 'TopNFinanceiro Value') e ""Demais"". Usada no gráfico de concentração por receita.</td></tr></table></div></div><div class=""row"" style=""align-items:flex-start""><div class=""cd""><div class=""fh""><span class=""fhn"">23 Financeiro (BCB) · Por Administradora</span><span class=""fhc"">4 medidas</span></div><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">Cor Resultado (BCB)</td><td class=""ds"">Cor condicional por resultado financeiro: vermelho para administradoras com prejuízo no período, verde para as com superávit.</td></tr><tr><td class=""nm"">Top 10 PL (BCB)</td><td class=""ds"">Sinalizador (1/0): indica se a administradora está entre as N maiores em Patrimônio Líquido (N definido pelo parâmetro 'TopNFinanceiro Value', ajustável pelo usuário), conforme Balancete do Banco Central. Usado para filtrar o gráfico de porte por PL.</td></tr><tr><td class=""nm"">Top 10 Receita Taxa Adm (BCB)</td><td class=""ds"">Sinalizador (1/0): indica se a administradora está entre as N maiores em Receita de Taxa de Administração (N definido pelo parâmetro 'TopNFinanceiro Value', ajustável pelo usuário), conforme Balancete do Banco Central. Usado para filtrar o gráfico de porte por receita.</td></tr><tr><td class=""nm"">Cor Faixa Concentração (BCB)</td><td class=""ds"">Cor condicional do gráfico de concentração por receita: azul para ""Top N"", cinza-claro para ""Demais"".</td></tr></table></div><div class=""cd""><div class=""fh""><span class=""fhn"">23 Financeiro (BCB) · Parâmetros</span><span class=""fhc"">2 medidas</span></div><table><tr><th>Medida</th><th>O que responde</th></tr><tr><td class=""nm"">TopNFinanceiro Value</td><td class=""ds"">Quantidade N usada nos rankings 'Top N' da página Financeiro (BCB), ajustável pelo usuário.</td></tr><tr><td class=""nm"">LimiarConcentracao Value</td><td class=""ds"">Limiar percentual (%) usado na análise de concentração dinâmica (tipo 80/20) da página Financeiro (BCB), ajustável pelo usuário.</td></tr></table></div></div><div class=""sp""></div><div class=""eb"">O que estes números não dizem</div><h2>Limitações declaradas</h2><div class=""row""><div class=""nt""><b>A base operacional não tem valor em reais.</b> A base do Comitê (ABAC) traz apenas quantidades de cotas: não há ticket médio nem faturamento por cota nessa fonte. Indicadores financeiros agregados por administradora (Patrimônio Líquido, Receita, Resultado) constam apenas na proposta de página com dados do Banco Central (BCB), sujeita à aprovação da presidência.</div><div class=""nt""><b>2026 é ano parcial.</b> A base vai até maio. Todo CAGR e toda comparação anual usam somente anos completos, de 2019 a 2025.</div></div><div class=""row""><div class=""nt""><b>Notas são relativas.</b> Os pilares do simulador normalizam de 0 a 100 dentro do segmento selecionado. Nota 100 significa melhor do grupo, não perfeição.</div><div class=""nt""><b>Correlação não é causa.</b> Coincidências temporais entre inadimplência e ciclo econômico aparecem nos gráficos, mas a base não permite afirmar relação causal.</div></div><div class=""sp"" style=""margin:16px 0 10px""></div><div class=""eb"">Aviso legal</div><div class=""nt"" style=""font-size:11px;line-height:1.6"">Este material tem caráter exclusivamente informativo e serve como base de consulta para profissionais e associados do Comitê dos Profissionais de Consórcio (ABEFIN). Nada aqui constitui recomendação de compra, contratação ou adesão a qualquer administradora, nem assessoria financeira, jurídica ou de investimento &mdash; em linha com o caráter não vinculante da informação previsto no Código de Defesa do Consumidor (Lei 8.078/1990) e no Código Civil (art. 927 e seguintes, sobre responsabilidade civil). Este material é <b>descritivo</b>: apresenta indicadores calculados a partir de dados públicos, sem atribuir nota, classificação de mérito ou recomendação. Rankings identificam o que medem &mdash; maiores e menores taxas de inadimplência &mdash; e não representam juízo de valor, endosso ou posicionamento institucional do Comitê ou da ABEFIN sobre qualquer administradora citada. O agrupamento por natureza da instituição controladora é classificação própria deste material, sujeita a revisão. Os dados têm origem pública (ABAC/BACEN) e são tratados à luz da regulamentação do Sistema de Consórcios (Lei 11.795/2008) e das normas do Banco Central do Brasil. A decisão de contratar qualquer produto de consórcio é exclusiva do consumidor, que deve consultar as condições contratuais e prospectos oficiais de cada administradora antes de decidir.</div><div class=""sp"" style=""margin:16px 0 10px""></div><div style=""display:flex;align-items:center;justify-content:space-between;gap:20px""><div style=""font-size:11.5px;color:#6B6A80"">Análise e visualização por <b style=""color:#1C1B2E"">Lucas Delfino</b><br>Analista de BI · Dados de Crédito e Cobrança</div><a href=""https://www.linkedin.com/in/lucasdelfino-/"" target=""_blank"" rel=""noopener"" style=""border:1px solid #4B3B9E;color:#4B3B9E;text-decoration:none;font-size:11.5px;font-weight:600;padding:9px 16px;border-radius:99px"">linkedin.com/in/lucasdelfino-</a></div><p class=""ft"">Fonte: dados públicos de consórcio (ABAC/BACEN), competências de jan/2019 a mai/2026. Esta página é gerada a partir do próprio modelo semântico, então acompanha qualquer mudança de fórmula.</p></div></div>"
		displayFolder: 30 HTML
		lineageTag: 71db89d1-1cbd-4c39-b99f-9f6991a4063e

	/// Versão da % Inadimplência (Fim) usada no eixo desacoplado do gráfico Inadimplência por administradora, para o slicer de Administradora não filtrar as barras.
	measure '% Inadimplência (Fim) [Gráfico]' =
			VAR _admin = SELECTEDVALUE ( dAdministradoraChart[Administradora] )
			RETURN
			    CALCULATE (
			        [% Inadimplência (Fim)],
			        TREATAS ( { _admin }, dAdministradora[Administradora] )
			    )
		formatString: 0.00%
		displayFolder: 12 Inadimplência\Administradora
		lineageTag: f5157c7b-bad9-4b48-81b7-619da079dd00

	/// 1 se a administradora é elegível pelo corte de participação de mercado OU se é a administradora selecionada no slicer (garante que a barra selecionada nunca desapareça).
	measure 'Mostrar no Gráfico (Admin)' =
			VAR _admin = SELECTEDVALUE ( dAdministradoraChart[Administradora] )
			VAR _elegivel =
			    CALCULATE (
			        [Elegível Ranking Inadimplência],
			        TREATAS ( { _admin }, dAdministradora[Administradora] )
			    )
			VAR _selecionada = SELECTEDVALUE ( dAdministradora[Administradora] )
			RETURN
			    IF ( _elegivel = 1 || _admin = _selecionada, 1, 0 )
		formatString: 0
		displayFolder: 12 Inadimplência\Administradora
		lineageTag: 62986e2a-1d1e-4a45-b9c4-06ac6bf078b1

	/// Farol de cores fixo do gráfico Inadimplência por administradora: azul (<10%), amarelo (10% a 20%) e vermelho (>20%), com base na inadimplência da própria barra. Ajustado em 22/08/2026 (reunião com Clayton) - antes destacava só a administradora selecionada no slicer.
	measure 'Cor Barra Inadimplência' =
			VAR _valor = [% Inadimplência (Fim) [Gráfico]]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _valor ), "#94A3AD",
			        _valor < 0.10, "#4B3B9E",
			        _valor <= 0.20, "#E3B23C",
			        "#C0453E"
			    )
		displayFolder: 12 Inadimplência\Administradora
		lineageTag: dde319fc-cdec-4a55-aa41-c589fff03dfb

	/// Patrimônio Líquido somado das administradoras, conforme Balancete do Banco Central (documento 4010, competência mais recente disponível).
	measure 'PL (BCB)' = SUM ( ft_BCB_Financeiro[Patrimonio_Liquido] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 4b6d1a75-eb44-4306-962f-5c7b2d4ba5a1

	/// Receitas operacionais somadas das administradoras, conforme Balancete do Banco Central.
	measure 'Receita Operacional (BCB)' = SUM ( ft_BCB_Financeiro[Receitas_Operacionais] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 44ba1b8b-be32-455f-93ce-0457c7fb53fd

	/// Despesas operacionais somadas das administradoras (valor já negativo na fonte), conforme Balancete do Banco Central.
	measure 'Despesa Operacional (BCB)' = SUM ( ft_BCB_Financeiro[Despesas_Operacionais] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: a6b0bd79-7d67-4534-a287-03fe23e28a8c

	/// Resultado aproximado do período (Receita Operacional + Despesa Operacional) no recorte selecionado. Positivo indica superávit, negativo indica prejuízo no período.
	measure 'Resultado do Período (BCB)' = [Receita Operacional (BCB)] + [Despesa Operacional (BCB)]
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 4ae3710e-2cf9-473b-a0bb-d282f763d10e

	/// Resultado do período dividido pela Receita Operacional: a margem financeira agregada do recorte selecionado.
	measure 'Margem do Resultado (BCB)' = DIVIDE ( [Resultado do Período (BCB)], [Receita Operacional (BCB)] )
		formatString: 0.0%
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 48f7955f-0a60-4dfe-8135-bf2c70c9757f

	/// Receita de taxas de administração de consórcios somada das administradoras, conforme Balancete do Banco Central.
	measure 'Receita Taxa Administração (BCB)' = SUM ( ft_BCB_Financeiro[Receita_Taxa_Administracao] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: f670a254-2289-4e0d-9521-414fa45d59fa

	/// Ativo total somado das administradoras (Total Geral do Ativo; usa Ativo Realizável como alternativa quando o total não é reportado), conforme Balancete do Banco Central. ATENÇÃO: para administradoras ligadas a conglomerados financeiros maiores, 'Total Geral do Ativo' pode refletir o balanço completo da instituição, não apenas a operação de consórcio (diferença observada de até ~95% frente à soma de Ativo Realizável + Ativo Permanente), portanto não é comparável entre administradoras de perfis distintos.
	measure 'Ativo Total (BCB)' = SUM ( ft_BCB_Financeiro[Ativo_Total_Calc] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 260199d2-cf81-473d-95f0-36a50be4761e

	/// Patrimônio Líquido dividido pelo Ativo Total: indica a capitalização (quanto do ativo é financiado com capital próprio) do recorte selecionado. ATENÇÃO: sujeito à mesma ressalva de 'Ativo Total (BCB)': não é comparável entre administradoras ligadas a conglomerados financeiros maiores e administradoras independentes.
	measure 'PL sobre Ativo (BCB)' = DIVIDE ( [PL (BCB)], [Ativo Total (BCB)] )
		formatString: 0.0%
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 68e07d09-e6f0-45cb-a03a-85433b6cb869

	/// Disponibilidades somadas a Títulos e Valores Mobiliários, usada como proxy de liquidez imediata das administradoras, conforme Balancete do Banco Central.
	measure 'Liquidez Disponível (BCB)' = SUM ( ft_BCB_Financeiro[Liquidez_Disp_TVM] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 91054d35-4748-462d-a5be-4eadb6316d62

	/// Quantidade de administradoras com dado financeiro reportado ao Banco Central no recorte selecionado.
	measure 'Qtd Administradoras (BCB)' = DISTINCTCOUNT ( ft_BCB_Financeiro[CNPJ] )
		formatString: 0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: be8c0297-becc-441f-98c8-0581617c2555

	/// Quantidade de administradoras que fecharam o período com resultado negativo (prejuízo), conforme Balancete do Banco Central.
	measure 'Qtd Administradoras com Prejuízo (BCB)' =
			CALCULATE (
			    DISTINCTCOUNT ( ft_BCB_Financeiro[CNPJ] ),
			    FILTER ( ft_BCB_Financeiro, ft_BCB_Financeiro[Resultado_Periodo] < 0 )
			)
		formatString: 0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 3f3e4dc3-8c54-4740-b7b6-04f761a645d8

	/// Percentual de administradoras com resultado negativo (prejuízo) no período, sobre o total de administradoras com dado financeiro disponível.
	measure '% Administradoras com Prejuízo (BCB)' = DIVIDE ( [Qtd Administradoras com Prejuízo (BCB)], [Qtd Administradoras (BCB)] )
		formatString: 0.0%
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 1b0c1c9a-90ac-437e-91a4-f89683d7eef9

	/// Receita de taxa de administração dividida pela Carteira Ativa (cotas em dia + inadimplentes), usada como proxy de receita média por cota sob gestão, cruzando dado financeiro (BCB) com dado operacional (base do Comitê).
	measure 'Receita por Cota (BCB)' = DIVIDE ( [Receita Taxa Administração (BCB)], [Carteira Ativa] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 0dfec815-7ada-4af3-88a0-8f925e4a97e1

	/// Participação das N administradoras com maior Patrimônio Líquido sobre o total do Patrimônio Líquido do sistema (N definido pelo parâmetro 'TopNFinanceiro Value'). ATENÇÃO: para administradoras ligadas a conglomerados financeiros maiores, o Patrimônio Líquido reportado ao BCB pode refletir capital da instituição inteira, não apenas da operação de consórcio, por isso este indicador deve ser lido com essa ressalva. Prefira 'Receita Top N % (BCB)' para leitura de concentração de mercado.
	measure 'PL Top 5 % (BCB)' =
			VAR _n = [TopNFinanceiro Value]
			VAR _t = TOPN ( _n, ALLSELECTED ( dAdministradora ), [PL (BCB)], DESC )
			VAR _topn = SUMX ( _t, [PL (BCB)] )
			VAR _total = CALCULATE ( [PL (BCB)], ALLSELECTED ( dAdministradora ) )
			RETURN
			    DIVIDE ( _topn, _total )
		formatString: 0.0%
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 813a8f30-abfd-4889-93e2-4a71a6702447

	/// Cor condicional por resultado financeiro: vermelho para administradoras com prejuízo no período, verde para as com superávit.
	measure 'Cor Resultado (BCB)' = IF ( [Resultado do Período (BCB)] < 0, "#C0453E", "#1E8A5F" )
		displayFolder: 23 Financeiro (BCB)\Por Administradora
		lineageTag: b388db88-e8ce-4c0f-90c0-47bdec5d2309

	/// Sinalizador (1/0): indica se a administradora está entre as N maiores em Patrimônio Líquido (N definido pelo parâmetro 'TopNFinanceiro Value', ajustável pelo usuário), conforme Balancete do Banco Central. Usado para filtrar o gráfico de porte por PL.
	measure 'Top 10 PL (BCB)' = IF ( RANKX ( ALLSELECTED ( dAdministradora ), [PL (BCB)], , DESC ) <= [TopNFinanceiro Value], 1, 0 )
		formatString: 0
		displayFolder: 23 Financeiro (BCB)\Por Administradora
		lineageTag: cb3b1ded-83bf-4b1a-82a1-211e42d019fd

	/// Sinalizador (1/0): indica se a administradora está entre as N maiores em Receita de Taxa de Administração (N definido pelo parâmetro 'TopNFinanceiro Value', ajustável pelo usuário), conforme Balancete do Banco Central. Usado para filtrar o gráfico de porte por receita.
	measure 'Top 10 Receita Taxa Adm (BCB)' = IF ( RANKX ( ALLSELECTED ( dAdministradora ), [Receita Taxa Administração (BCB)], , DESC ) <= [TopNFinanceiro Value], 1, 0 )
		formatString: 0
		displayFolder: 23 Financeiro (BCB)\Por Administradora
		lineageTag: 9ea24753-bc3e-42bd-8ef1-a6a6017fb17f

	/// Participação das N administradoras com maior Receita de Taxa de Administração sobre o total do sistema (N definido pelo parâmetro 'TopNFinanceiro Value'). Indicador de concentração de mercado recomendado, por ser calculado sobre uma métrica de receita operacional segmentada, o que a torna mais comparável entre administradoras do que indicadores de Patrimônio Líquido ou Ativo Total.
	measure 'Receita Top N % (BCB)' =
			VAR _n = [TopNFinanceiro Value]
			VAR _t = TOPN ( _n, ALLSELECTED ( dAdministradora ), [Receita Taxa Administração (BCB)], DESC )
			VAR _topn = SUMX ( _t, [Receita Taxa Administração (BCB)] )
			VAR _total = CALCULATE ( [Receita Taxa Administração (BCB)], ALLSELECTED ( dAdministradora ) )
			RETURN
			    DIVIDE ( _topn, _total )
		formatString: 0.0%
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 288ba032-a816-44a1-abea-fc377342c036

	/// Quantidade mínima de administradoras (ordenadas da maior para a menor Receita de Taxa de Administração) necessária para atingir o limiar percentual definido pelo parâmetro 'LimiarConcentracao Value' (análise de concentração dinâmica, tipo 80/20).
	measure 'Qtd Administradoras no Limiar (BCB)' =
			VAR _limiar = DIVIDE ( [LimiarConcentracao Value], 100 )
			VAR _t = ADDCOLUMNS ( FILTER ( ALLSELECTED ( dAdministradora ), [Receita Taxa Administração (BCB)] > 0 ), "@r", [Receita Taxa Administração (BCB)] )
			VAR _tot = SUMX ( _t, [@r] )
			VAR _cum =
			    ADDCOLUMNS (
			        _t,
			        "@cum",
			            VAR _rk = RANKX ( _t, [@r], , DESC )
			            RETURN SUMX ( FILTER ( _t, RANKX ( _t, [@r], , DESC ) <= _rk ), [@r] )
			    )
			RETURN
			    IF ( _tot = 0, BLANK (), COUNTROWS ( FILTER ( _cum, DIVIDE ( [@cum], _tot ) < _limiar ) ) + 1 )
		formatString: 0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 517e3911-0fbe-4171-96be-18132f57ab63

	/// Percentual que a quantidade de administradoras no limiar de concentração representa sobre o total de administradoras com dado financeiro disponível.
	measure '% Administradoras no Limiar (BCB)' = DIVIDE ( [Qtd Administradoras no Limiar (BCB)], [Qtd Administradoras (BCB)] )
		formatString: 0.0%
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 48ba9758-fe5b-4784-957d-ecf9cfbc7a02

	/// Frase-resumo da análise de concentração dinâmica (tipo 80/20): quantas administradoras, e que fração do total, concentram o limiar percentual de receita definido pelo usuário.
	measure 'Resumo Concentração (BCB)' =
			VAR _n = [Qtd Administradoras no Limiar (BCB)]
			VAR _pctAdmin = [% Administradoras no Limiar (BCB)]
			VAR _limiar = [LimiarConcentracao Value]
			RETURN
			    IF (
			        ISBLANK ( _n ), "Sem dado suficiente para esta seleção.",
			        _n & " administradora" & IF ( _n = 1, "", "s" ) & " (" & FORMAT ( _pctAdmin, "0%" ) & " do total) concentram " & _limiar & "% da Receita de Taxa de Administração do sistema."
			    )
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 3cbdcf0f-6c55-4ab1-8f0e-2bf6e8c3e857

	/// Soma dos saldos da tabela detalhada de contas do balancete (ft_BCB_ContaDetalhe), usada na matriz de balanço padrão por administradora selecionada.
	measure 'Saldo do Item (BCB)' = SUM ( ft_BCB_ContaDetalhe[Saldo] )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 123b5ff0-b6d4-4ee0-926e-1423a751c858

	/// Receita de Taxa de Administração somada, dividida entre "Top N" (as N administradoras com maior receita, N definido pelo parâmetro 'TopNFinanceiro Value') e "Demais". Usada no gráfico de concentração por receita.
	measure 'Receita por Faixa (BCB)' =
			VAR _faixa = SELECTEDVALUE ( FaixaConcentracao[Faixa] )
			VAR _n = [TopNFinanceiro Value]
			VAR _t = TOPN ( _n, ALLSELECTED ( dAdministradora ), [Receita Taxa Administração (BCB)], DESC )
			VAR _topSoma = SUMX ( _t, [Receita Taxa Administração (BCB)] )
			VAR _total = CALCULATE ( [Receita Taxa Administração (BCB)], ALLSELECTED ( dAdministradora ) )
			RETURN
			    SWITCH (
			        _faixa,
			        "Top N", _topSoma,
			        "Demais", _total - _topSoma,
			        BLANK ()
			    )
		formatString: #,0
		displayFolder: 23 Financeiro (BCB)
		lineageTag: 7c3be10d-3538-4eec-aec9-379a5f77a294

	/// Cor condicional do gráfico de concentração por receita: azul para "Top N", cinza-claro para "Demais".
	measure 'Cor Faixa Concentração (BCB)' = SWITCH ( SELECTEDVALUE ( FaixaConcentracao[Faixa] ), "Top N", "#1F6FB2", "Demais", "#D8DEE9", "#94A3AD" )
		displayFolder: 23 Financeiro (BCB)\Por Administradora
		lineageTag: 2ec0f7b0-f781-4399-8595-f84eec0a0bed

