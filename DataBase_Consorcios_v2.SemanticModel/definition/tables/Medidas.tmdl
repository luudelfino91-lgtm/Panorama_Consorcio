table Medidas
	lineageTag: a69d7b20-c9f9-4110-ad50-c7ca5c87b3e3

	/// Quantidade de grupos de consórcio em atividade no recorte selecionado.
	measure 'Grupos Ativos' = SUM ( ft_Consorcios[Quantidade_de_grupos_ativos] )
		formatString: 0
		displayFolder: 01 Base
		lineageTag: 80fd9ef4-cc85-4227-b643-5ff7445523fc

	/// Quantidade de cotas comercializadas (vendidas) no mês, dentro do recorte selecionado.
	measure 'Cotas Comercializadas' = SUM ( ft_Consorcios[Quantidade_de_cotas_comercializadas_no_mês] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 6055fe0e-7c8d-465a-98f7-8861c3e46c1d

	/// Quantidade de cotas ativas adimplentes (em dia com os pagamentos), no recorte selecionado.
	measure 'Cotas Em Dia' = SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_em_dia] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 6172c84f-4506-40f2-bdde-6a7dceff8b30

	/// Quantidade de cotas ativas inadimplentes, somando contempladas e não contempladas em atraso, no recorte selecionado.
	measure 'Cotas Inadimplentes' =
			VAR _contempladas = SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_contempladas_inadimplentes] )
			VAR _naoContempladas = SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_não_contempladas_inadimplentes] )
			RETURN
			    _contempladas + _naoContempladas
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 1c168228-2d49-4613-99ca-d52cffd8adf4

	/// Total de cotas ativas na carteira (em dia + inadimplentes), somado ao longo do recorte selecionado. Para o saldo em um ponto no tempo (sem dupla contagem), use Carteira Ativa (Fim).
	measure 'Carteira Ativa' = [Cotas Em Dia] + [Cotas Inadimplentes]
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 5b91a002-f598-4021-ae27-db8db21e6434

	/// Quantidade de cotas contempladas no mês, dentro do recorte selecionado.
	measure 'Cotas Contempladas Mês' = SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_contempladas_no_mês] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 36df073a-09ad-442d-b893-90ccf979256f

	/// Percentual de cotas inadimplentes sobre a carteira ativa, somado ao longo do recorte selecionado (média do período). Para a foto no último mês do recorte, use % Inadimplência (Fim).
	measure '% Inadimplência' = DIVIDE ( [Cotas Inadimplentes], [Carteira Ativa] )
		formatString: 0.00%
		displayFolder: 03 Risco
		lineageTag: afd3dd5d-a8a7-4bbe-b749-d21c99272df2

	/// Taxa de administração média da carteira, ponderada pela quantidade de grupos ativos de cada linha do fato, no recorte selecionado.
	measure 'Taxa Adm Carteira %' =
			VAR Pesado =
			    SUMX (
			        ft_Consorcios,
			        VAR t = ft_Consorcios[Taxa_de_administração]
			        VAR tNorm = IF ( t > 1, t / 100, t )
			        RETURN tNorm * ft_Consorcios[Quantidade_de_grupos_ativos]
			    )
			RETURN DIVIDE ( Pesado, [Grupos Ativos] )
		formatString: 0.00%
		displayFolder: 04 Taxa
		lineageTag: b102c705-89f7-4370-89ba-35d141ef53e7

	/// Saldo de fechamento da carteira ativa: pega o valor do ULTIMO mes do contexto (semiaditiva). Use para mostrar o estoque em cartoes/visuais por ano ou periodo, sem dupla contagem.
	measure 'Carteira Ativa (Fim)' = LASTNONBLANKVALUE ( dCalendario[Data], [Carteira Ativa] )
		formatString: #,0
		displayFolder: 01 Base\Fim de Período
		lineageTag: 2068f017-df68-4a9b-9bdf-96a17a7cbc12

	/// Cotas inadimplentes no ULTIMO mes do contexto (semiaditiva, saldo de fechamento).
	measure 'Cotas Inadimplentes (Fim)' = LASTNONBLANKVALUE ( dCalendario[Data], [Cotas Inadimplentes] )
		formatString: #,0
		displayFolder: 01 Base\Fim de Período
		lineageTag: 5bc5b4bf-5d2f-493e-b960-5fe7d83a7d63

	/// Inadimplencia no ULTIMO mes do contexto (foto de fechamento), em vez da media do periodo.
	measure '% Inadimplência (Fim)' = DIVIDE ( [Cotas Inadimplentes (Fim)], [Carteira Ativa (Fim)] )
		formatString: 0.00%
		displayFolder: 03 Risco\Fim de Período
		lineageTag: 8a6ef238-2974-4e03-86cb-b4e695749c93

	/// Helper: ultima data presente no fato, ignorando filtros de calendario. Base das medidas (Atual).
	measure 'Última Data Base' = CALCULATE ( MAX ( ft_Consorcios[Data Base] ), ALL ( dCalendario ) )
		formatString: mmm/yyyy
		isHidden
		displayFolder: 08 Atual (sem filtro)
		lineageTag: d0f39109-68ec-401f-9d86-4dc4f91c9ab2

	/// Carteira ativa no ULTIMO mes da base (foto atual do estoque), ignorando filtro de ano.
	measure 'Carteira Ativa (Atual)' =
			VAR _ult = [Última Data Base]
			RETURN
			    CALCULATE (
			        [Carteira Ativa],
			        ALL ( dCalendario ),
			        ft_Consorcios[Data Base] = _ult
			    )
		formatString: #,0
		displayFolder: 08 Atual (sem filtro)
		lineageTag: 81e20fc5-63b3-49aa-b1fb-ef5e120fedb4

	/// Selo de porte da administradora com base na Carteira Ativa (Atual): Pequena (<10 mil cotas), Média (10 mil a 100 mil) ou Grande (>100 mil). Faixas de referência iniciais, ajustáveis. Adicionado em 22/08/2026 (reunião com Clayton) para dar contexto de tamanho no comparador de administradoras.
	measure 'Porte (Carteira Ativa)' =
			VAR _carteira = [Carteira Ativa (Atual)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _carteira ), BLANK (),
			        _carteira < 10000, "Pequena",
			        _carteira < 100000, "Média",
			        "Grande"
			    )
		formatString: 0
		displayFolder: 01 Base
		lineageTag: a3f1c9e2-8b7d-4d5a-9c0e-1f2a3b4c5d6e

	/// Inadimplencia no ULTIMO mes da base (foto atual), sem filtro de ano.
	measure '% Inadimplência (Atual)' = ```
			
			VAR _ult = [Última Data Base] 
			RETURN 
			CALCULATE ( 
			    [% Inadimplência], 
			    ALL ( dCalendario ),
			    ft_Consorcios[Data Base] = _ult 
			)
			```
		formatString: 0.00%
		displayFolder: 08 Atual (sem filtro)
		lineageTag: c84ba8ec-5142-4eb4-8e9f-ebc42b9fe81f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cotas ativas ainda nao contempladas.
	measure 'Cotas Não Contempladas' = SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_não_contempladas] )
		formatString: #,0
		displayFolder: 01 Base
		lineageTag: 74501806-606e-4f84-a62f-a9d617b160c1

	/// Taxa de administracao (ponderada por grupos) no ultimo mes da base.
	measure 'Taxa Adm (Atual) %' =
			VAR _ult = [Última Data Base]
			RETURN
			    CALCULATE (
			        [Taxa Adm Carteira %],
			        ALL ( dCalendario ),
			        ft_Consorcios[Data Base] = _ult
			    )
		formatString: 0.0%
		displayFolder: 08 Atual (sem filtro)
		lineageTag: 97e3e4e0-62eb-4f11-b639-a0e2641e498a

	/// Rapidez de contemplacao: contempladas nos ultimos 12M sobre a media de cotas nao contempladas (ao ano).
	measure 'Taxa Contemplação (Atual) %' =
			VAR _ult = [Última Data Base]
			VAR _ini = EDATE ( _ult, -11 )
			VAR _c =
			    CALCULATE (
			        [Cotas Contempladas Mês],
			        ALL ( dCalendario ),
			        DATESBETWEEN ( dCalendario[Data], _ini, _ult )
			    )
			VAR _n =
			    CALCULATE (
			        AVERAGEX ( VALUES ( dCalendario[Data] ), [Cotas Não Contempladas] ),
			        ALL ( dCalendario ),
			        DATESBETWEEN ( dCalendario[Data], _ini, _ult )
			    )
			RETURN
			    DIVIDE ( _c, _n )
		formatString: 0.0%
		displayFolder: 08 Atual (sem filtro)
		lineageTag: f74db26f-f01e-4daf-9ba7-592dc4668063

	/// Carteira ativa do segmento inteiro no ultimo mes (denominador do share).
	measure 'Carteira Ativa Segmento (Atual)' = CALCULATE ( [Carteira Ativa (Atual)], ALL ( dAdministradora ) )
		formatString: #,0
		displayFolder: 08 Atual (sem filtro)
		lineageTag: 8697b974-4dda-4ad3-b25b-69f2399df525

	/// Participacao da administradora na carteira ativa do segmento.
	measure 'Share Carteira no Segmento %' = DIVIDE ( [Carteira Ativa (Atual)], [Carteira Ativa Segmento (Atual)] )
		formatString: 0.0%
		displayFolder: 08 Atual (sem filtro)
		lineageTag: 6d95d6fd-0df5-4dee-93b4-7426a2133318

	/// Participacao da administradora na carteira ativa TOTAL do mercado (todos os segmentos), usada como criterio de porte para o ranking de inadimplencia.
	measure 'Share Carteira Mercado (Atual) %' = DIVIDE ( [Carteira Ativa (Atual)], CALCULATE ( [Carteira Ativa (Atual)], ALL ( dAdministradora ) ) )
		formatString: 0.00%
		displayFolder: 12 Inadimplência\Administradora
		lineageTag: a7921699-ac44-4ab9-a724-8a39d2be7157

	/// 1 = administradora com pelo menos 0,5% da carteira ativa do mercado (evita que administradoras minusculas, com poucas cotas, distorçam o ranking de inadimplencia).
	measure 'Elegível Ranking Inadimplência' = IF ( [Share Carteira Mercado (Atual) %] >= 0.005, 1, 0 )
		formatString: 0
		displayFolder: 12 Inadimplência\Administradora
		lineageTag: a3606770-bfcc-400f-9561-32ca7f8278c4

	/// Inadimplencia do mercado no recorte selecionado, ignorando o filtro de administradora.
	measure '% Inadimplência Mercado' = CALCULATE ( [% Inadimplência (Fim)], ALL ( dAdministradora ) )
		formatString: 0.00%
		displayFolder: 21 Dinâmico
		lineageTag: 271988ba-95b4-475a-ab39-1982c71d9eea

	/// Quanto a inadimplencia da administradora esta acima (+) ou abaixo (-) do mercado, em pontos percentuais.
	measure 'Δ vs Mercado (p.p.)' = ( [% Inadimplência (Fim)] - [% Inadimplência Mercado] ) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: 21 Dinâmico
		lineageTag: 503c6f09-db8e-47d4-94bf-daa7762af8ab

	/// Carteira ativa do mercado no recorte, ignorando o filtro de administradora.
	measure 'Carteira Ativa Mercado (Fim)' = CALCULATE ( [Carteira Ativa (Fim)], ALL ( dAdministradora ) )
		formatString: #,0
		displayFolder: 21 Dinâmico
		lineageTag: b43c7ca0-cfbd-445f-a605-d280d39fd933

	/// Participacao da administradora na carteira do mercado, no recorte selecionado.
	measure 'Share Carteira (Fim) %' = DIVIDE ( [Carteira Ativa (Fim)], [Carteira Ativa Mercado (Fim)] )
		formatString: 0.0%
		displayFolder: 21 Dinâmico
		lineageTag: 5e367db0-d2cb-4458-9464-ce6d59aad03f

	/// Nome da administradora filtrada, ou texto padrao quando nenhuma esta selecionada.
	measure 'Administradora Selecionada' = SELECTEDVALUE ( dAdministradora[Administradora], "Todas as administradoras" )
		displayFolder: 21 Dinâmico
		lineageTag: 2ca1f83a-e614-41b8-863d-93995f837c0e

	/// Texto do recorte de periodo em uso.
	measure 'Período Selecionado' =
			VAR _n = CALCULATE ( DISTINCTCOUNT ( dCalendario[MesAnoNumero] ), ft_Consorcios )
			VAR _numIni = CALCULATE ( MIN ( dCalendario[MesAnoNumero] ), ft_Consorcios )
			VAR _numFim = CALCULATE ( MAX ( dCalendario[MesAnoNumero] ), ft_Consorcios )
			VAR _ini = LOOKUPVALUE ( dCalendario[MesAnoNome], dCalendario[MesAnoNumero], _numIni )
			VAR _fim = LOOKUPVALUE ( dCalendario[MesAnoNome], dCalendario[MesAnoNumero], _numFim )
			RETURN
			    IF ( _n <= 1, _fim, _ini & " até " & _fim )
		displayFolder: 21 Dinâmico
		lineageTag: da689bed-3d13-4ed1-aa5f-73561d6d3f3c

	/// Inadimplencia entre quem ja foi contemplado, no recorte selecionado.
	measure '% Inadimplência Contemplados' = DIVIDE ( SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_contempladas_inadimplentes] ), SUM ( ft_Consorcios[Quantidade_acumulada_de_cotas_ativas_contempladas] ) )
		formatString: 0.00%
		displayFolder: 21 Dinâmico
		lineageTag: d4daeb3d-b858-4d81-8a8a-51c52dc3f113

	/// Inadimplencia entre quem ainda nao foi contemplado, no recorte selecionado.
	measure '% Inadimplência Não Contemplados' = DIVIDE ( SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_não_contempladas_inadimplentes] ), SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_não_contempladas] ) )
		formatString: 0.00%
		displayFolder: 21 Dinâmico
		lineageTag: ab501943-63af-48f9-bb58-e28e0e893181

	/// Diferenca em pontos percentuais entre a inadimplencia de contemplados e a de quem ainda nao foi contemplado.
	measure 'Δ Contemplados vs Não Contemplados (p.p.)' = ( [% Inadimplência Contemplados] - [% Inadimplência Não Contemplados] ) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: 21 Dinâmico
		lineageTag: 82d9a63e-bebc-4975-9f5f-a82dfe59929d

	/// Grupos de consórcio constituídos dentro do período selecionado (fluxo, soma entre meses).
	measure 'Grupos Constituídos' = SUM ( ft_Consorcios[Quantidade_de_grupos_constituídos_no_mês] )
		formatString: #,0
		displayFolder: 13 Grupos
		lineageTag: c0000001-1111-4222-8333-000000000001

	/// Grupos encerrados dentro do período selecionado (fluxo, soma entre meses).
	measure 'Grupos Encerrados' = SUM ( ft_Consorcios[Quantidade_de_grupos_encerrados_no_mês] )
		formatString: #,0
		displayFolder: 13 Grupos
		lineageTag: c0000001-1111-4222-8333-000000000002

	/// Constituídos menos encerrados no período. Negativo indica que o parque de grupos encolheu.
	measure 'Saldo de Grupos' = [Grupos Constituídos] - [Grupos Encerrados]
		formatString: #,0
		displayFolder: 13 Grupos
		lineageTag: c0000001-1111-4222-8333-000000000003

	/// Grupos ativos no último mês do período. É estoque: não deve ser somado entre meses.
	measure 'Grupos Ativos (Fim)' = LASTNONBLANKVALUE ( dCalendario[Data], [Grupos Ativos] )
		formatString: #,0
		displayFolder: 13 Grupos
		lineageTag: c0000001-1111-4222-8333-000000000004

	/// Tamanho médio do grupo: cotas ativas por grupo ativo no fim do período.
	measure 'Cotas por Grupo (Fim)' = DIVIDE ( [Carteira Ativa (Fim)], [Grupos Ativos (Fim)] )
		formatString: #,0
		displayFolder: 13 Grupos
		lineageTag: c0000001-1111-4222-8333-000000000005

	/// Fração da fila contemplada a cada mês, em média no período: contempladas por mês sobre o estoque médio de não contempladas.
	measure 'Taxa Contemplação Mensal %' =
			VAR _meses =
			    COUNTROWS ( FILTER ( VALUES ( dCalendario[Data] ), NOT ISBLANK ( [Cotas Não Contempladas] ) ) )
			VAR _fila = AVERAGEX ( VALUES ( dCalendario[Data] ), [Cotas Não Contempladas] )
			RETURN
			    DIVIDE ( DIVIDE ( [Cotas Contempladas Mês], _meses ), _fila )
		formatString: 0.00%
		displayFolder: 14 Contemplação
		lineageTag: c0000001-1111-4222-8333-000000000006

	/// Taxa que a administradora teria se cada segmento dela rodasse na taxa média do mercado. Serve de referência para separar desempenho de mix de produto.
	measure 'Taxa Contemplação Esperada %' =
			VAR _seg =
			    ADDCOLUMNS (
			        VALUES ( dSegmento[CodSegmento] ),
			        "@fila", [Cotas Não Contempladas],
			        "@tx", CALCULATE ( [Taxa Contemplação Mensal %], ALL ( dAdministradora ) )
			    )
			RETURN
			    DIVIDE ( SUMX ( _seg, [@fila] * [@tx] ), SUMX ( _seg, [@fila] ) )
		formatString: 0.00%
		displayFolder: 14 Contemplação
		lineageTag: c0000001-1111-4222-8333-000000000008

	/// Contemplação observada dividida pela esperada para o mix de segmentos da própria administradora. Acima de 1 contempla mais rápido que o mercado no mesmo tipo de bem; abaixo de 1, mais devagar. Compara a administradora com o padrão do produto que ela vende, não com administradoras de outro porte ou outro segmento.
	measure 'Índice de Contemplação (vs mix)' = DIVIDE ( [Taxa Contemplação Mensal %], [Taxa Contemplação Esperada %] )
		formatString: #,0.00
		displayFolder: 14 Contemplação
		lineageTag: c0000001-1111-4222-8333-000000000009

	/// Estoque acumulado de cotas excluídas (canceladas e desistências) no fim do período. É acumulado histórico: não deve ser somado entre meses e não entra no cálculo de inadimplência.
	measure 'Cotas Canceladas (Acum)' = LASTNONBLANKVALUE ( dCalendario[Data], SUM ( ft_Consorcios[Quantidade_de_cotas_excluídas] ) )
		formatString: #,0
		displayFolder: 15 Cancelamento
		lineageTag: c0000001-1111-4222-8333-000000000010

	/// Cancelamentos ocorridos dentro do recorte, somando mês a mês a variação do estoque acumulado. Variações negativas (retificações da fonte) são tratadas como zero. Antes esta medida comparava o fim do período contra o mês anterior a ele, o que devolvia branco quando o recorte começava no início da base.
	measure 'Cotas Canceladas no Período' =
			SUMX (
			    VALUES ( ft_Consorcios[Data Base] ),
			    VAR _d = ft_Consorcios[Data Base]
			    VAR _atual = CALCULATE ( SUM ( ft_Consorcios[Quantidade_de_cotas_excluídas] ) )
			    VAR _ant =
			        CALCULATE (
			            SUM ( ft_Consorcios[Quantidade_de_cotas_excluídas] ),
			            ALL ( dCalendario ),
			            ALL ( ft_Consorcios[Data Base] ),
			            ft_Consorcios[Data Base] = EDATE ( _d, -1 )
			        )
			    RETURN
			        IF (
			            ISBLANK ( _atual ) || ISBLANK ( _ant ),
			            BLANK (),
			            MAX ( _atual - _ant, 0 )
			        )
			)
		formatString: #,0
		displayFolder: 15 Cancelamento
		lineageTag: c0000001-1111-4222-8333-000000000011

	/// Cotas já canceladas para cada 100 cotas ativas hoje. Indicador de estoque: não depende de diferença entre períodos, então é estável em qualquer recorte. No mercado inteiro roda perto de 95 por 100.
	measure 'Canceladas por 100 Ativas' = DIVIDE ( [Cotas Canceladas (Acum)], [Carteira Ativa (Fim)] ) * 100
		formatString: #,0.0
		displayFolder: 15 Cancelamento
		lineageTag: c0000001-1111-4222-8333-000000000019

	/// Cancelamentos por 100 cotas vendidas no mesmo período. Lê a qualidade da venda: quanto do que entra não se sustenta. Herda a ressalva de Cotas Canceladas no Período: usar em nível de mercado e segmento, não para ranquear administradoras.
	measure 'Canceladas por 100 Vendidas' = DIVIDE ( [Cotas Canceladas no Período], [Cotas Comercializadas] ) * 100
		formatString: #,0.0
		displayFolder: 15 Cancelamento
		lineageTag: c0000001-1111-4222-8333-000000000012

	/// Cotas ativas já quitadas no fim do período.
	measure 'Cotas Quitadas (Fim)' = LASTNONBLANKVALUE ( dCalendario[Data], SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_quitadas] ) )
		formatString: #,0
		displayFolder: 16 Ciclo da Cota
		lineageTag: c0000001-1111-4222-8333-000000000013

	/// Estoque de cotas ativas já contempladas no fim do período.
	measure 'Contempladas Acum (Fim)' = LASTNONBLANKVALUE ( dCalendario[Data], SUM ( ft_Consorcios[Quantidade_acumulada_de_cotas_ativas_contempladas] ) )
		formatString: #,0
		displayFolder: 16 Ciclo da Cota
		lineageTag: c0000001-1111-4222-8333-000000000014

	/// Cotas já contempladas cujo crédito ainda não foi utilizado, no fim do período.
	measure 'Crédito Pendente (Fim)' = LASTNONBLANKVALUE ( dCalendario[Data], SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_com_crédito_pendente_de_utilização] ) )
		formatString: #,0
		displayFolder: 16 Ciclo da Cota
		lineageTag: c0000001-1111-4222-8333-000000000015

	/// Fração dos contemplados que ainda não usou o crédito.
	measure '% Crédito Pendente' = DIVIDE ( [Crédito Pendente (Fim)], [Contempladas Acum (Fim)] )
		formatString: 0.00%
		displayFolder: 16 Ciclo da Cota
		lineageTag: c0000001-1111-4222-8333-000000000016

	/// Fração da inadimplência total que vem de cotas já contempladas.
	measure 'Peso Contemplados na Inadimplência %' = DIVIDE ( SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_contempladas_inadimplentes] ), [Cotas Inadimplentes] )
		formatString: 0.00%
		displayFolder: 12 Inadimplência\Composição
		lineageTag: c0000001-1111-4222-8333-000000000017

	/// Fração da inadimplência total que vem de cotas ainda não contempladas.
	measure 'Peso Não Contemplados na Inadimplência %' = DIVIDE ( SUM ( ft_Consorcios[Quantidade_de_cotas_ativas_não_contempladas_inadimplentes] ), [Cotas Inadimplentes] )
		formatString: 0.00%
		displayFolder: 12 Inadimplência\Composição
		lineageTag: c0000001-1111-4222-8333-000000000018

	/// HTML estatico do Panorama (Ato 1 a 4). Use no visual HTML Content, campo Values.
	measure 'HTML Panorama' =
			
