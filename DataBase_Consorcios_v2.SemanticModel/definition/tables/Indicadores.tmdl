	partition Indicadores = calculated
		mode: import
		source = ```
				{
				    ("Carteira ativa", NAMEOF('Medidas'[Carteira Ativa (Fim)]), 0),
				    ("Inadimplência", NAMEOF('Medidas'[% Inadimplência (Fim)]), 1),
				    ("Inadimplência · contemplados", NAMEOF('Medidas'[% Inadimplência Contemplados]), 2),
				    ("Inadimplência · não contemplados", NAMEOF('Medidas'[% Inadimplência Não Contemplados]), 3),
				    ("Diferença contempl. x não contempl. (p.p.)", NAMEOF('Medidas'[Δ Contemplados vs Não Contemplados (p.p.)]), 4),
				    ("Inadimplência vs mercado (p.p.)", NAMEOF('Medidas'[Δ vs Mercado (p.p.)]), 5),
				    ("Taxa de administração", NAMEOF('Medidas'[Taxa Adm Carteira %]), 6),
				    ("Contemplação mensal", NAMEOF('Medidas'[Taxa Contemplação Mensal %]), 7),
				    ("Cotas vendidas", NAMEOF('Medidas'[Cotas Comercializadas]), 8),
				    ("Canceladas por 100 vendidas", NAMEOF('Medidas'[Canceladas por 100 Vendidas]), 9),
				    ("Canceladas por 100 ativas", NAMEOF('Medidas'[Canceladas por 100 Ativas]), 10),
				    ("Crédito não utilizado", NAMEOF('Medidas'[% Crédito Pendente]), 11),
				    ("Cotas quitadas", NAMEOF('Medidas'[Cotas Quitadas (Fim)]), 12),
				    ("Grupos ativos", NAMEOF('Medidas'[Grupos Ativos (Fim)]), 13),
				    ("Cotas por grupo", NAMEOF('Medidas'[Cotas por Grupo (Fim)]), 14)
				}
				```

